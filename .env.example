# 复制本文件为 .env 并填入你的真实 key（.env 已被 .gitignore 忽略，不会提交）
# Copy this file to .env and fill in your real key.

LLM_API_KEY=sk-xxx
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash             # 或 deepseek-v4-pro

# DEBUG 模式：设为 1 等价于命令行加 --debug（记录 Agent↔LLM / Agent↔MCP 全部交互到 debug_logs/）
# MCP_DEBUG=1
